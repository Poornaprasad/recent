{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-suppressed-warnings.js",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package && npm run copy-pdf-worker",
    "copy-pdf-worker": "cp node_modules/react-pdf/node_modules/pdfjs-dist/build/pdf.worker.min.mjs public/pdf.worker.min.mjs || true",
    "db:init": "tsx src/lib/db/init.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:clear": "tsx src/lib/db/clear-db.ts",
    "db:clear-except-vendors": "tsx src/lib/db/clear-except-vendors.ts",
    "db:reset": "tsx src/lib/db/reset-db.ts",
    "db:apply-fks": "tsx src/lib/db/apply-foreign-keys.ts",
    "db:debug-invoice": "tsx src/lib/db/debug-invoice.ts",
    "db:seed": "tsx src/lib/db/seed-test-user.ts",
    "db:import-vendors": "tsx scripts/import-vendors-from-csv.ts",
    "sync:documents": "tsx scripts/sync-documents.ts"
  },
