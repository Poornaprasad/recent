# Database Configuration
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_management

# Alternative format for connection pooling (recommended for production)
# DATABASE_URL=postgresql://user:password@host:port/dbname?sslmode=require&connection_limit=10

# AI Configuration
# Google AI (Gemini) API Key for invoice data extraction
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Firebase Configuration (for file storage)
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Application Configuration
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# JWT Authentication
# Required in production - generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_generate_with_openssl_rand_hex_32

# File Storage Configuration
STORAGE_TYPE=local
# Options: local, firebase, s3
# For local storage, files are stored in ./uploads directory
# For firebase/s3, additional configuration required

# Security
SESSION_SECRET=your_session_secret_here_change_in_production

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Feature Flags
ENABLE_AI_EXTRACTION=true
ENABLE_DUPLICATE_DETECTION=true
ENABLE_RECURRING_BILL_ANALYSIS=true

# SmartAdvocate CRM Integration
SA_API_BASE_URL=https://api.smartadvocate.com
SA_API_KEY=your_smartadvocate_api_key_here
# Alternative: Use username/password authentication
# SA_USERNAME=your_username
# SA_PASSWORD=your_password

# Document Sync Configuration
# Optional: Manual date range for sync (YYYY-MM-DD format)
# If not set, cron job will use yesterday's date range
SA_DOCUMENT_SYNC_FROM_DATE=2024-01-01
SA_DOCUMENT_SYNC_TO_DATE=2024-12-31
SA_DOCUMENT_SYNC_PAGE_SIZE=100
SA_DOCUMENT_SYNC_CATEGORY_IDS=78,1080

# Document Sync Cron Job Configuration
# Enable/disable automated document synchronization
DOCUMENT_SYNC_CRON_ENABLED=false
# Cron schedule expression (default: every 6 hours)
# Format: "minute hour day month weekday"
# Examples:
#   "0 */6 * * *"   - Every 6 hours (default)
#   "0 2 * * *"     - Every day at 2 AM
#   "0 8,20 * * *"  - Twice daily at 8 AM and 8 PM
#   "0 0,6,12,18 * * *" - Four times daily (midnight, 6 AM, noon, 6 PM)
DOCUMENT_SYNC_CRON_SCHEDULE=0 */6 * * *
# Timezone for cron schedule
DOCUMENT_SYNC_CRON_TIMEZONE=America/New_York
